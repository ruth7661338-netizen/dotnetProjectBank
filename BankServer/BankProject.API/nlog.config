<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Off"
      internalLogFile="logs/internal-nlog.txt">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <!--
    הערה חשובה: אסור לרשום ללוג סיסמאות, JWT tokens או תוכן של בקשת הרשמה/התחברות.
    שימי לב לזה כשמוסיפים לוגים סביב האימות במשימת ה-JWT הבאה.
  -->

  <targets>
    <!-- קובץ יומי עם כל הלוגים, כולל CorrelationId מה-scope שנוצר ב-CorrelationIdMiddleware -->
    <target xsi:type="File" name="allfile"
            fileName="${basedir}/logs/bankproject-all-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|CorrelationId=${scopeproperty:item=CorrelationId}|${message} ${exception:format=tostring}" />

    <!-- קובץ נפרד רק ללוגים מהקוד שלנו (לא מ-ASP.NET Core הפנימי) -->
    <target xsi:type="File" name="ownFile"
            fileName="${basedir}/logs/bankproject-own-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|CorrelationId=${scopeproperty:item=CorrelationId}|${message} ${exception:format=tostring}" />

    <target xsi:type="Console" name="console"
            layout="${longdate}|${level:uppercase=true}|CorrelationId=${scopeproperty:item=CorrelationId}|${message} ${exception:format=tostring}" />
  </targets>

  <rules>
    <!-- הרעש הפנימי של ASP.NET Core (routing, hosting וכו') - מעל Info לא מעניין אותנו -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <!-- Debug לפיתוח, Information לזרימה רגילה, Warning לחריג שטופל (למשל concurrency), Error לכשל -->
    <logger name="*" minlevel="Debug" writeTo="allfile,console" />
    <logger name="BankProject.*" minlevel="Debug" writeTo="ownFile" />
  </rules>
</nlog>
